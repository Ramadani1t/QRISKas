<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background hitam -->
    <item>
        <color android:color="#0a0903"/>
    </item>
    <!-- Logo Q di tengah -->
    <item
        android:gravity="center"
        android:width="96dp"
        android:height="96dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp"/>
            <gradient
                android:angle="135"
                android:startColor="#ffe566"
                android:endColor="#ffd000"
                android:type="linear"/>
        </shape>
    </item>
    <!-- Letter Q overlay: gunakan ic_launcher_foreground atau teks -->
    <item
        android:gravity="center"
        android:drawable="@mipmap/ic_launcher_foreground"/>
</layer-list>
